--- /dev/null
+++ b/packages/coding-agent/test/provider-payload-finalized.test.ts
@@ -0,0 +1,216 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { Agent } from "@oh-my-pi/pi-agent-core";
+import { streamSimple, type Context, type FetchImpl, type Model } from "@oh-my-pi/pi-ai";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { loadExtensions } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/loader";
+import { ExtensionRunner } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/runner";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import {
+	SessionProviderBoundary,
+	type SessionProviderBoundaryHost,
+} from "@oh-my-pi/pi-coding-agent/session/session-provider-boundary";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const bundledModel = getBundledModel<"openai-completions">("openai", "gpt-4o-mini");
+if (!bundledModel) throw new Error("Expected bundled OpenAI completions model");
+const model = {
+	...bundledModel,
+	api: "openai-completions",
+} satisfies Model<"openai-completions">;
+
+const context: Context = {
+	messages: [{ role: "user", content: "Do the task", timestamp: 1 }],
+};
+
+function sseResponse(): Response {
+	const events = [
+		{
+			id: "provider-payload-test",
+			object: "chat.completion.chunk",
+			created: 1,
+			model: model.id,
+			choices: [{ index: 0, delta: { content: "ok" } }],
+		},
+		{
+			id: "provider-payload-test",
+			object: "chat.completion.chunk",
+			created: 1,
+			model: model.id,
+			choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+		},
+	];
+	const body = `${events.map(event => `data: ${JSON.stringify(event)}`).join("\n\n")}\n\ndata: [DONE]\n\n`;
+	return new Response(body, { status: 200, headers: { "content-type": "text/event-stream" } });
+}
+
+describe("provider_payload_finalized production provider boundary", () => {
+	let tempDir: TempDir;
+	let extensionsDir: string;
+	let registry: ModelRegistry;
+	let authStorage: AuthStorage;
+
+	beforeEach(async () => {
+		tempDir = TempDir.createSync("@pi-provider-payload-");
+		extensionsDir = tempDir.join("extensions");
+		fs.mkdirSync(extensionsDir, { recursive: true });
+		authStorage = await AuthStorage.create(path.join(tempDir.path(), "auth.db"));
+		registry = new ModelRegistry(authStorage, path.join(tempDir.path(), "models.yml"));
+	});
+
+	afterEach(() => {
+		authStorage.close();
+		tempDir.removeSync();
+	});
+
+	async function makeRunner(): Promise<ExtensionRunner> {
+		const loaded = await loadExtensions(
+			fs.readdirSync(extensionsDir).sort().map(name => path.join(extensionsDir, name)),
+			tempDir.path(),
+		);
+		return new ExtensionRunner(loaded.extensions, loaded.runtime, tempDir.path(), SessionManager.inMemory(), registry);
+	}
+
+	function makeBoundary(runner: ExtensionRunner): SessionProviderBoundary {
+		const sessionManager = SessionManager.inMemory(tempDir.path());
+		const host: SessionProviderBoundaryHost = {
+			agent: { metadataForProvider: () => undefined } as unknown as Agent,
+			sessionManager,
+			settings: Settings.isolated(),
+			modelRegistry: registry,
+			model: () => model,
+			sessionId: () => "provider-payload-session",
+			localProtocolOptions: () => ({
+				getArtifactsDir: () => tempDir.path(),
+				getSessionId: () => "provider-payload-session",
+			}),
+			transformContext: messages => messages,
+			convertToLlm: () => context.messages,
+			onPayload: (payload, requestModel, signal) =>
+				runner.emitBeforeProviderRequest(payload, requestModel, signal),
+			onResponse: undefined,
+			onSseEvent: undefined,
+			obfuscator: () => undefined,
+		};
+		// A legacy session-wide observer must not be inherited by side requests.
+		Object.assign(host, {
+			onPayloadFinalized: (serializedBody: string, requestModel: Model, signal?: AbortSignal) =>
+				runner.emitProviderPayloadFinalized(serializedBody, requestModel, signal),
+		});
+		return new SessionProviderBoundary(host);
+	}
+
+	it("keeps the session observer off side requests but preserves an explicit raw callback", async () => {
+		const observerFile = path.join(tempDir.path(), "provider-payload.json");
+		const observerOrderFile = path.join(tempDir.path(), "observer-order.txt");
+		fs.writeFileSync(
+			path.join(extensionsDir, "01-add-context.ts"),
+			`export default function(pi) {
+				pi.on("before_provider_request", event => {
+					const payload = event.payload;
+					if (!payload || typeof payload !== "object" || Array.isArray(payload)) return;
+					const messages = Array.isArray(payload.messages) ? payload.messages : [];
+					return { ...payload, messages: [...messages, { role: "user", content: "must-not-survive" }] };
+				});
+			}`,
+		);
+		fs.writeFileSync(
+			path.join(extensionsDir, "02-strip-context.ts"),
+			`export default function(pi) {
+				pi.on("before_provider_request", event => {
+					const payload = event.payload;
+					if (!payload || typeof payload !== "object" || Array.isArray(payload)) return;
+					const messages = Array.isArray(payload.messages) ? payload.messages : [];
+					return {
+						...payload,
+						messages: messages.filter(message => {
+							if (!message || typeof message !== "object" || Array.isArray(message)) return true;
+							return message.content !== "must-not-survive";
+						}),
+					};
+				});
+			}`,
+		);
+		fs.writeFileSync(
+			path.join(extensionsDir, "03-observe-final.ts"),
+			`import * as fs from "node:fs";
+			export default function(pi) {
+				pi.on("provider_payload_finalized", event => {
+					if (!Object.isFrozen(event)) throw new Error("final provider payload event must be immutable");
+					if (
+						event.provider !== "openai" ||
+						event.api !== "openai-completions" ||
+						event.model !== ${JSON.stringify(model.id)}
+					) {
+						throw new Error("final provider model metadata mismatch");
+					}
+					fs.writeFileSync(${JSON.stringify(observerFile)}, event.serializedBody, "utf8");
+					fs.appendFileSync(${JSON.stringify(observerOrderFile)}, "session\\n", "utf8");
+					return "observer return must be ignored";
+				});
+			}`,
+		);
+
+		const runner = await makeRunner();
+		const boundary = makeBoundary(runner);
+		let sentBody: string | undefined;
+		let requestObserverBody: string | undefined;
+		const fetchMock: FetchImpl = async (_input, init) => {
+			sentBody = typeof init?.body === "string" ? init.body : undefined;
+			return sseResponse();
+		};
+		const preparedOptions = boundary.prepareSimpleStreamOptions({
+			apiKey: "test-key",
+			fetch: fetchMock,
+			onPayloadFinalized: serializedBody => {
+				requestObserverBody = serializedBody;
+				fs.appendFileSync(observerOrderFile, "request\n", "utf8");
+			},
+		}, "openai");
+		const result = await streamSimple(model, context, preparedOptions).result();
+
+		expect(result.stopReason).toBe("stop");
+		expect(sentBody).toBeDefined();
+		expect(fs.existsSync(observerFile)).toBe(false);
+		if (sentBody === undefined) throw new Error("Expected the provider fetch to receive a serialized body");
+		expect(requestObserverBody).toBe(sentBody);
+		expect(fs.readFileSync(observerOrderFile, "utf8").split("\n").filter(Boolean)).toEqual([
+			"request",
+		]);
+		expect(sentBody).not.toContain("must-not-survive");
+	}, 10_000);
+
+	it("fails closed when an observer handler errors before the actual provider fetch", async () => {
+		fs.writeFileSync(
+			path.join(extensionsDir, "observer-error.ts"),
+			`export default function(pi) {
+				pi.on("provider_payload_finalized", () => { throw new Error("final observer error"); });
+			}`,
+		);
+		const runner = await makeRunner();
+		const boundary = makeBoundary(runner);
+		let sends = 0;
+		const observedErrors: string[] = [];
+		runner.onError(error => observedErrors.push(error.event));
+		const preparedOptions = boundary.prepareSimpleStreamOptions({
+			apiKey: "test-key",
+			fetch: async () => {
+				sends += 1;
+				return sseResponse();
+			},
+			onPayloadFinalized: (serializedBody, requestModel, signal) =>
+				runner.emitProviderPayloadFinalized(serializedBody, requestModel ?? model, signal),
+		}, "openai");
+		const result = await streamSimple(model, context, preparedOptions).result();
+
+		expect(sends).toBe(0);
+		expect(result.stopReason).toBe("error");
+		expect(result.errorMessage).toContain("final observer error");
+		expect(observedErrors.length).toBeGreaterThan(0);
+		expect(observedErrors.every(event => event === "provider_payload_finalized")).toBe(true);
+	}, 10_000);
+});
