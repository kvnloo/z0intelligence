diff --git a/packages/ai/test/provider-payload-finalized.test.ts b/packages/ai/test/provider-payload-finalized.test.ts
new file mode 100644
index 0000000..b568125
--- /dev/null
+++ b/packages/ai/test/provider-payload-finalized.test.ts
@@ -0,0 +1,201 @@
+import { describe, expect, it } from "bun:test";
+import { streamOllama } from "@oh-my-pi/pi-ai/providers/ollama";
+import { streamOpenAICompletions } from "@oh-my-pi/pi-ai/providers/openai-completions";
+import { streamOpenAIResponses } from "@oh-my-pi/pi-ai/providers/openai-responses";
+import type { Context, FetchImpl, Model } from "@oh-my-pi/pi-ai/types";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+
+const ollamaModel: Model<"ollama-chat"> = buildModel({
+	id: "qwen3.6-coder:27b",
+	name: "Qwen 3.6 Coder 27B",
+	api: "ollama-chat",
+	provider: "ollama",
+	baseUrl: "http://127.0.0.1:11434",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 131_072,
+	maxTokens: 8192,
+});
+
+const bundledOpenAIModel = getBundledModel<"openai-completions">("openai", "gpt-4o-mini");
+if (!bundledOpenAIModel) throw new Error("Expected bundled OpenAI completions model");
+const openAIModel = {
+	...bundledOpenAIModel,
+	api: "openai-completions",
+} satisfies Model<"openai-completions">;
+const openAIResponsesModel: Model<"openai-responses"> = buildModel({
+	id: "gpt-4o-mini",
+	name: "GPT-4o mini",
+	api: "openai-responses",
+	provider: "openai",
+	baseUrl: "https://api.openai.com/v1",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 128_000,
+	maxTokens: 16_384,
+});
+
+function objectValue(value: unknown): value is Record<string, unknown> {
+	return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+const context: Context = {
+	messages: [{ role: "user", content: "Use the prepared context", timestamp: 1 }],
+};
+
+function openAIResponse(): Response {
+	const events = [
+		{
+			id: "finalized-test",
+			object: "chat.completion.chunk",
+			created: 1,
+			model: openAIModel.id,
+			choices: [{ index: 0, delta: { content: "ok" } }],
+		},
+		{
+			id: "finalized-test",
+			object: "chat.completion.chunk",
+			created: 1,
+			model: openAIModel.id,
+			choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+		},
+	];
+	const body = `${events.map(event => `data: ${JSON.stringify(event)}`).join("\n\n")}\n\ndata: [DONE]\n\n`;
+	return new Response(body, { status: 200, headers: { "content-type": "text/event-stream" } });
+}
+
+describe("final provider payload observer", () => {
+	it("observes the exact Ollama JSON body after replacement", async () => {
+		let observed: string | undefined;
+		let sent: string | undefined;
+		const fetchMock = async (_input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+			sent = typeof init?.body === "string" ? init.body : undefined;
+			return new Response('{"message":{"content":"ok"},"done":true,"done_reason":"stop"}\n', {
+				status: 200,
+			});
+		};
+
+		const result = await streamOllama(ollamaModel, context, {
+			apiKey: "test-key",
+			fetch: fetchMock,
+			onPayload: payload => objectValue(payload) ? { ...payload, options: { temperature: 0.25 } } : payload,
+			onPayloadFinalized: serializedBody => {
+				observed = serializedBody;
+			},
+		}).result();
+
+		expect(result.stopReason).toBe("stop");
+		expect(observed).toBeDefined();
+		expect(observed).toBe(sent);
+		expect(JSON.parse(sent ?? "null")).toMatchObject({ options: { temperature: 0.25 } });
+	}, 10_000);
+
+	it("aborts an Ollama send when final observation fails", async () => {
+		let sends = 0;
+		const result = await streamOllama(ollamaModel, context, {
+			apiKey: "test-key",
+			fetch: async () => {
+				sends += 1;
+				return new Response('{"message":{"content":"unexpected"},"done":true}\n');
+			},
+			onPayloadFinalized: () => {
+				throw new Error("observer failed closed");
+			},
+		}).result();
+
+		expect(sends).toBe(0);
+		expect(result.stopReason).toBe("error");
+		expect(result.errorMessage).toContain("observer failed closed");
+	}, 10_000);
+
+	it("observes the exact OpenAI Completions JSON body and aborts on observer failure", async () => {
+		let observed: string | undefined;
+		let sent: string | undefined;
+		const fetchMock: FetchImpl = async (_input, init) => {
+			sent = typeof init?.body === "string" ? init.body : undefined;
+			return openAIResponse();
+		};
+
+		const result = await streamOpenAICompletions(openAIModel, context, {
+			apiKey: "test-key",
+			fetch: fetchMock,
+			onPayload: payload => objectValue(payload) ? { ...payload, temperature: 0.25 } : payload,
+			onPayloadFinalized: serializedBody => {
+				observed = serializedBody;
+			},
+		}).result();
+
+		expect(result.stopReason).toBe("stop");
+		expect(observed).toBeDefined();
+		expect(observed).toBe(sent);
+		expect(JSON.parse(sent ?? "null")).toMatchObject({ temperature: 0.25 });
+
+		let sends = 0;
+		const failed = await streamOpenAICompletions(openAIModel, context, {
+			apiKey: "test-key",
+			fetch: async () => {
+				sends += 1;
+				return openAIResponse();
+			},
+			onPayloadFinalized: () => {
+				throw new Error("observer failed closed");
+			},
+		}).result();
+		expect(sends).toBe(0);
+		expect(failed.stopReason).toBe("error");
+		expect(failed.errorMessage).toContain("observer failed closed");
+	}, 10_000);
+
+	it("does not claim final-body observation for OpenAI Responses", async () => {
+		let observations = 0;
+		let sent: string | undefined;
+		const events = [
+			{
+				type: "response.output_item.added",
+				item: { type: "message", id: "msg-finalized", role: "assistant", status: "in_progress", content: [] },
+			},
+			{ type: "response.content_part.added", part: { type: "output_text", text: "" } },
+			{ type: "response.output_text.delta", delta: "ok" },
+			{
+				type: "response.output_item.done",
+				item: {
+					type: "message",
+					id: "msg-finalized",
+					role: "assistant",
+					status: "completed",
+					content: [{ type: "output_text", text: "ok" }],
+				},
+			},
+			{
+				type: "response.completed",
+				response: {
+					status: "completed",
+					usage: { input_tokens: 1, output_tokens: 1, total_tokens: 2 },
+				},
+			},
+		];
+		const response = new Response(
+			`${events.map(event => `data: ${JSON.stringify(event)}`).join("\n\n")}\n\n`,
+			{ status: 200, headers: { "content-type": "text/event-stream" } },
+		);
+		const fetchMock: FetchImpl = async (_input, init) => {
+			sent = typeof init?.body === "string" ? init.body : undefined;
+			return response;
+		};
+
+		const result = await streamOpenAIResponses(openAIResponsesModel, context, {
+			apiKey: "test-key",
+			fetch: fetchMock,
+			onPayloadFinalized: () => {
+				observations += 1;
+			},
+		}).result();
+
+		expect(sent).toBeDefined();
+		expect(observations).toBe(0);
+		expect(result.stopReason).toBe("stop");
+	}, 10_000);
+});
