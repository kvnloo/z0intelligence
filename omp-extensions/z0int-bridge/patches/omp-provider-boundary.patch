+import { describe, expect, it } from "bun:test";
+import { Agent } from "@oh-my-pi/pi-agent-core";
+import type { StreamFn } from "@oh-my-pi/pi-agent-core";
+import type { SimpleStreamOptions } from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+
+describe("Agent final provider payload callback", () => {
+	it("forwards the configured observer in main-turn stream options", async () => {
+		const mock = createMockModel({ responses: [{ content: ["done"] }] });
+		const finalized: NonNullable<SimpleStreamOptions["onPayloadFinalized"]> = () => {};
+		let captured: SimpleStreamOptions["onPayloadFinalized"];
+		const streamFn: StreamFn = (model, context, options) => {
+			captured = options?.onPayloadFinalized;
+			return mock.stream(model, context, options);
+		};
+		const agent = new Agent({
+			initialState: { model: mock.model, messages: [] },
+			streamFn,
+			onPayloadFinalized: finalized,
+		});
+
+		await agent.prompt("exercise the configured observer");
+
+		expect(captured).toBe(finalized);
+	});
+});
