# Copy selected values into ~/.config/z0intelligence/service.env.
# This file is documentation only; do not commit credentials here.

Z0INT_PYTHON=/path/to/venv/bin/python
Z0INT_BIND=127.0.0.1

# Governed remote canary: explicit opt-in.
Z0INT_GOVERNED_REMOTE=1
Z0INT_AODL_CONTRACT_PATH=/absolute/path/to/z0intelligence/contracts/aodl/governed-worker-v1.json
Z0INT_AODL_PARENT_NODE_ID=parent
Z0INT_AODL_PARENT_DEPTH=0
Z0INT_GOVERNED_PROVIDER=openrouter
Z0INT_GOVERNED_HARNESS=omp

# Must be reachable from the host authority process.
# For the first Kind canary, prefer an explicit loopback port-forward:
#   kubectl -n hermes-lab port-forward svc/z0intelligence-executor 11503:11503
Z0INT_REMOTE_EXECUTOR_URL=http://127.0.0.1:11503
