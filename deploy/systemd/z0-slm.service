[Unit]
Description=z0 SLM: llama.cpp Vulkan router on the R9 M370X (127.0.0.1:11520 and the Kind bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Host 0 runs the same llama.cpp router on CUDA0, tailnet :11530, models-max 2, ctx 8192.
# This card is RADV VERDE, 2048 MiB, no fp16 and no matrix cores. One resident model,
# ctx 2048, parallel 1. The 1.7B Q4 is on demand only; it may refuse if the desktop holds VRAM.
ExecStart=/home/kvn/.local/opt/llama.cpp/b11270-vulkan/llama-server --models-dir /home/kvn/.local/share/z0int-models/router --models-max 1 --device Vulkan0 -ngl 99 -c 2048 --parallel 1 --host 127.0.0.1 --port 11520 --no-webui --reasoning off -t 4 --sleep-idle-seconds 900
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
