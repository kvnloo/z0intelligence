# Optional inputs for z0.capacity.snapshot.v1.
# The local direct-host probe is always available without these files.
#
# Each source is read-only and optional. Producers own their own truth.

# Normalized Tern host/session export.
# Z0INT_TERN_CAPACITY_SNAPSHOT=%h/.cache/tern/z0-capacity.json

# Kerdoios provider/capacity export.
# Z0INT_KERDOIOS_CAPACITY_SNAPSHOT=%h/.cache/kerdoios/capacity.json

# Optional active/recent placement lease projection.
# Z0INT_PLACEMENT_LEASES_SNAPSHOT=%h/.z0int/state/placement_leases.json
