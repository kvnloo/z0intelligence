[Unit]
Description=z0intelligence local cognition model supervisor (shadow lane models on 127.0.0.1:11500)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Same env file as z0intelligence.service: it sets Z0INT_PYTHON and PYTHONPATH.
EnvironmentFile=%h/.config/z0intelligence/service.env
# Loopback only. One model is resident at a time and is unloaded after 600 s idle.
ExecStart=/bin/sh -c 'exec "$Z0INT_PYTHON" -m z0int cognition serve --host 127.0.0.1 --port 11500 --idle-unload 600'
Restart=on-failure
RestartSec=3
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
