# Keeps the AgentsView label/memory index fresh instead of an always-on daemon. A shared hold on the quiet-lane lock
# that waits at most 60 s; a timeout exits 0 (-E 0), so an exclusive window only skips one sync.
# Enable only after the one-off v74 -> v113 resync has completed (owner-scheduled, outside experiment windows).
[Unit]
Description=AgentsView incremental sync under the shared quiet-lane lock

[Service]
Type=oneshot
Environment=AGENTSVIEW_DATA_DIR=/mnt/zer0models/sft-svlm/data/agentsview
ExecStart=/usr/bin/flock -s -w 60 -E 0 /mnt/zer0models/cua-lane-tmp/locks/quiet-lane.lock %h/.local/bin/agentsview sync
Nice=19
IOSchedulingClass=idle
