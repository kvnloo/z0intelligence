# Keeps the AgentsView label/memory index fresh instead of an always-on daemon (matches the owner-approved ops unit,
# z0-wt/wiring/ops/agentsview/agentsview-sync.service). A shared hold on the quiet-lane lock that waits at most 60 s;
# a timeout exits 0 (-E 0), so an exclusive window only skips one sync.
[Unit]
Description=AgentsView one-shot archive sync (shared quiet-lane lock, no daemon)

[Service]
Type=oneshot
Environment=AGENTSVIEW_DATA_DIR=/mnt/zer0models/sft-svlm/data/agentsview
# Required since v0.44: plain `agentsview sync` otherwise starts a background serve daemon that outlives this
# oneshot (and the lock). With it, sync writes directly and exits, or routes through an MCP-started daemon if one
# is already up.
Environment=AGENTSVIEW_NO_DAEMON=1
ExecStart=/usr/bin/flock -s -w 60 -E 0 /mnt/zer0models/cua-lane-tmp/locks/quiet-lane.lock %h/.local/bin/agentsview sync
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=50min
