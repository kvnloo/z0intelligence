+// pick draws an index uniformly, or in proportion to ModelRef.Weight when any
+// candidate carries one. Weight 0 then means "fallback only": the candidate is
+// never drawn first but stays in the eligible list the fallback walks.
+func (s *RandomSelector) pick(candidates []config.ModelRef) int {
+	total := 0.0
+	for _, c := range candidates {
+		if c.Weight > 0 {
+			total += c.Weight
+		}
+	}
+	if total <= 0 {
+		return s.intn(len(candidates))
+	}
+	const scale = 1 << 30
+	r := float64(s.intn(scale)) / scale * total
+	for i, c := range candidates {
+		if c.Weight <= 0 {
+			continue
+		}
+		if r < c.Weight {
+			return i
+		}
+		r -= c.Weight
+	}
+	for i := len(candidates) - 1; i >= 0; i-- {
+		if candidates[i].Weight > 0 {
+			return i
+		}
+	}
+	return 0
+}
