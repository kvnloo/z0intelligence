+package extproc
+
+import (
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+// An agent turn carries the client's earlier tool results. Replaying that body
+// to another candidate runs no tool again, so fallback must stay allowed.
+func TestClientToolResultsKeepFallbackAllowed(t *testing.T) {
+	ctx := &RequestContext{SemanticRequest: &llmprotocol.Request{Messages: []llmprotocol.Message{
+		{Role: llmprotocol.RoleUser},
+		{Role: llmprotocol.RoleTool},
+	}}}
+	if ctx.hasNonIdempotentToolExecution() {
+		t.Fatal("client-side tool results must not block fallback")
+	}
+	if fallbackCommitState(ctx).HasNonIdempotentSideEffects {
+		t.Fatal("commit state must not report side effects for client tool results")
+	}
+}
