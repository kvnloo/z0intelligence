@@ -0,0 +1,31 @@
+package selection
+
+import (
+	"context"
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+)
+
+// Weights steer the first draw in proportion; weight 0 is fallback-only.
+func TestRandomSelector_WeightedDraw(t *testing.T) {
+	selector := NewRandomSelector()
+	selCtx := &SelectionContext{CandidateModels: []config.ModelRef{
+		{Model: "heavy", Weight: 3}, {Model: "light", Weight: 1}, {Model: "reserve"},
+	}}
+	const draws = 8000
+	counts := map[string]int{}
+	for i := 0; i < draws; i++ {
+		result, err := selector.Select(context.Background(), selCtx)
+		if err != nil {
+			t.Fatalf("Select failed: %v", err)
+		}
+		counts[result.SelectedModel]++
+	}
+	if counts["reserve"] != 0 {
+		t.Fatalf("weight-0 candidate drawn first %d times", counts["reserve"])
+	}
+	if share := float64(counts["heavy"]) / draws; share < 0.68 || share > 0.82 {
+		t.Fatalf("heavy share %.2f, want ~0.75 (counts %v)", share, counts)
+	}
+}
