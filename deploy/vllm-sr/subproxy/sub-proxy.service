[Unit]
Description=Subscription proxy for vLLM-SR paid lanes (Hermes credential pool -> Anthropic/Codex/xAI)
After=network-online.target k3s.service

[Service]
Type=simple
Slice=agent.slice
Environment=HERMES_HOME=%h/.hermes/profiles/clean
Environment=SUBPROXY_HOST=10.42.0.1
Environment=SUBPROXY_PORT=18800
ExecStart=/usr/bin/python3 /mnt/zer0models/workspace/zer0/oss/tools/dsh-env-exec.py --allow VLLM_SR_SUBPROXY_TOKEN -- %h/.local/share/sub-proxy/python3 -I /mnt/zer0models/z0-wt/z0int-vllm-sr-turbo/deploy/vllm-sr/subproxy/sub_proxy.py
