  "rules": [
    {
      "category": "local",
      "pattern": "\\blocal-only\\b",
      "provider": "local",
      "remote_fallback": false
    },
    {
      "category": "code",
      "pattern": "\\b(python|javascript|sql|function|code|regex)\\b",
      "provider": "cerebras"
    },
    {
      "category": "structured",
      "pattern": "\\b(json|csv|extract|sort|sum|calculate|arithmetic)\\b",
      "provider": "groq"
    },
    {
      "category": "language",
      "pattern": "\\b(translate|translation|summarize|summary)\\b",
      "provider": "deepseek"
    },
    {
      "category": "critique",
      "pattern": "\\b(critique|counterargument|weakness)\\b",
      "provider": "grok"
    },
    {
      "category": "comparison",
      "pattern": "\\b(compare|comparison|tradeoffs)\\b",
      "provider": "nous"
    },
    {
      "category": "classification",
      "pattern": "\\b(classify|classification|sentiment)\\b",
      "provider": "nvidia"
    },
    {
      "category": "rewrite",
      "pattern": "\\b(rewrite|proofread|grammar)\\b",
      "provider": "openrouter"
    }
  ],
