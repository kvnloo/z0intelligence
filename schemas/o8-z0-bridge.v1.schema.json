{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/z0intelligence/schemas/o8-z0-bridge.v1.schema.json",
  "title": "o8 <-> z0intelligence bridge request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "mode",
    "operation_id",
    "trace_id",
    "integration_instance",
    "deadline_unix_ms",
    "lane",
    "capability",
    "policy"
  ],
  "properties": {
    "protocol_version": {"const": "o8.z0.bridge.v1"},
    "mode": {"enum": ["shadow", "advisory", "active"]},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integration_instance": {
      "type": "string",
      "pattern": "^o8-instance:[0-9a-f]{16,64}$"
    },
    "deadline_unix_ms": {"type": "integer", "minimum": 1},
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "packet_id": {"type": ["string", "null"], "maxLength": 200},
        "project_id": {"type": ["string", "null"], "maxLength": 200},
        "runtime": {"type": ["string", "null"], "maxLength": 64},
        "revision": {"type": "integer", "minimum": 0}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "task"],
      "properties": {
        "function": {"type": "string", "minLength": 1, "maxLength": 200},
        "task": {"type": "string", "minLength": 1, "maxLength": 16000},
        "context": {"type": "string", "maxLength": 16000},
        "state": {},
        "expected_parent_tokens": {"type": "number", "minimum": 0},
        "expected_parent_ms": {"type": "number", "minimum": 0},
        "experimental": {"type": "boolean"},
        "automatic": {"type": "boolean"},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 2048}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_remote_context",
        "free_only",
        "risk_class",
        "approval_state"
      ],
      "properties": {
        "allow_remote_context": {"type": "boolean"},
        "free_only": {"type": "boolean"},
        "risk_class": {
          "enum": ["read", "artifact", "mutation", "external_side_effect"]
        },
        "approval_state": {
          "enum": ["not_required", "required", "granted", "denied", "unknown"]
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "retrieved_at", "sha256", "content"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "retrieved_at": {"type": "string", "format": "date-time", "maxLength": 64},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content": {"type": "string", "minLength": 1, "maxLength": 2048},
          "privacy": {"enum": ["PUBLIC", "LOCAL", "PRIVATE", "EPHEMERAL"]}
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judgment_receipt_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "approval_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "outcome_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}