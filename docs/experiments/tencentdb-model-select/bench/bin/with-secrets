#!/usr/bin/env bash
# with-secrets NAME[,NAME...] -- cmd args...
# Fetch BWS secrets by NAME through the same keyring->bws mechanism as
# ../../bin/tencentdb-memory-run and export them ONLY into the child process env.
# Never prints values; prints names + lengths to stderr.
set -euo pipefail
names="$1"; shift; [[ "${1:-}" == "--" ]] && shift
BWS_BIN="${TENCENTDB_BWS_BIN:-~/.hermes/profiles/chiefstaff/bin/bws}"
token="$(secret-tool lookup service org.hermes.agent key bws-access-token 2>/dev/null || true)"
[[ -n "${token// /}" ]] || { echo "with-secrets: keyring locked / no BWS token" >&2; exit 1; }
list="$(BWS_ACCESS_TOKEN="$token" "$BWS_BIN" secret list -o json --color no 2>/dev/null)"
unset token
IFS=, read -ra arr <<<"$names"
for n in "${arr[@]}"; do
  v="$(jq -r --arg k "$n" '[.[] | select(.key==$k)][0].value // empty' <<<"$list")"
  [[ -n "$v" ]] || { echo "with-secrets: secret $n not found" >&2; exit 1; }
  export "$n=$v"
  echo "with-secrets: loaded $n (len=${#v})" >&2
done
unset list v
exec "$@"
