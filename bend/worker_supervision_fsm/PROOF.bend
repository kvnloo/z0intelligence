# Worker supervision: the proofs of LAWS.bend.
# Generated by gen_proof.py (it stamps the per-event cases); edit there.

import Base
import ./fsm.bend as F
import ./LAWS.bend as Laws

# Proof kit
# ---------

def and_l(+a: Bool, -b: Bool, w: Laws.T(Bool.and(a, b))) -> Laws.T(a):
  match a:
    case True{}:
      Unit{}
    case False{}:
      Empty.absurd(Laws.T(False{}), w)

def eq_sound(a: Nat, b: Nat, w: Laws.T(Nat.is_eq(a, b))) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, w)
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, w)
    case 1n+p 1n+q:
      %eq_sound(p, q, w) : {1n+p == 1n+_ : Nat}
      {==}

def eq_refl(n: Nat) -> Laws.T(Nat.is_eq(n, n)):
  match n:
    case 0n:
      Unit{}
    case 1n+p:
      eq_refl(p)

def not_both(b: Bool, r: Laws.T(b), w: Laws.T(Bool.not(b))) -> Empty:
  match b:
    case True{}:
      w
    case False{}:
      r

def self_not_stolen(+o: Nat, w: Laws.T(Laws.distinct(o, o))) -> Empty:
  not_both(Nat.is_eq(o, o), eq_refl(o), w)

def pick_true(ok: Bool, -x: F.St, -y: F.St, k: Laws.T(ok)) -> {F.pick(ok, x, y) == x : F.St}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({y == x : F.St}, k)

# Law 1. The lease
# ----------------

def rel_steal(ok: Bool, +o: Nat, w: Laws.T(Laws.stolen(o, F.lpick(ok, F.Free{}, F.Held{o})))) -> Empty:
  match ok:
    case True{}:
      w
    case False{}:
      self_not_stolen(o, w)

def recl_steal(dead: Bool, +a: Nat, +o: Nat, w: Laws.T(Laws.stolen(o, F.lpick(dead, F.Held{a}, F.Held{o})))) -> Laws.T(dead):
  match dead:
    case True{}:
      Unit{}
    case False{}:
      self_not_stolen(o, w)

def Laws.lease_no_steal(o, e, w):
  match e:
    case F.Acquire{a}:
      self_not_stolen(o, w)
    case F.Release{+a}:
      rel_steal(Nat.is_eq(a, o), o, w)
    case F.Reclaim{+a, +dead}:
      recl_steal(dead, a, o, w)

def rel_free(ok: Bool, +o: Nat, w: Laws.T(Laws.is_free(F.lpick(ok, F.Free{}, F.Held{o})))) -> Laws.T(ok):
  match ok:
    case True{}:
      Unit{}
    case False{}:
      w

def recl_free(dead: Bool, +a: Nat, +o: Nat, w: Laws.T(Laws.is_free(F.lpick(dead, F.Held{a}, F.Held{o})))) -> Empty:
  match dead:
    case True{}:
      w
    case False{}:
      w

def Laws.lease_release_by_holder(o, e, w):
  match e:
    case F.Acquire{a}:
      w
    case F.Release{+a}:
      eq_sound(a, o, rel_free(Nat.is_eq(a, o), o, w))
    case F.Reclaim{+a, +dead}:
      recl_free(dead, a, o, w)

def Laws.lease_free_acquires(a):
  {==}

def Laws.write_needs_lease(l, a, w):
  match l:
    case F.Free{}:
      Empty.absurd({F.Free{} == F.Held{a} : F.Lease}, w)
    case F.Held{+o}:
      %eq_sound(o, a, w) : {F.Held{o} == F.Held{_} : F.Lease}
      {==}

# Law 2. Interrupted workers resolve
# ----------------------------------

def Laws.interrupted_can_resume(w, at, bg, by, lim):
  {==}

def Laws.interrupted_can_abandon(w, at, lim):
  {==}

def Laws.interrupted_overdue(w, at, bg, now, lim, h):
  pick_true(F.late(now, at, lim), F.Overdue{w, at, bg}, F.Interrupted{w, at, bg}, h)

def Laws.overdue_needs_kevin(w, at, bg):
  {==}

def int_pick(ok: Bool, -x: F.St, -y: F.St, ix: Laws.IntExit(x), iy: Laws.IntExit(y)) -> Laws.IntExit(F.pick(ok, x, y)):
  match ok:
    case True{}:
      ix
    case False{}:
      iy

def over_pick(ok: Bool, -x: F.St, -y: F.St, ix: Laws.OverExit(x), iy: Laws.OverExit(y)) -> Laws.OverExit(F.pick(ok, x, y)):
  match ok:
    case True{}:
      ix
    case False{}:
      iy

def Laws.interrupted_exits(w, at, bg, e, lim):
  match e:
    case F.Start{h, t}:
      Unit{}
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{+now}:
      int_pick(F.late(now, at, lim), F.Overdue{w, at, bg}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{+by, +log}:
      int_pick(log, F.Resumed{w, by, bg}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Abandon{}:
      int_pick(F.is_zero(bg), F.Abandoned{w}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Integrate{}:
      Unit{}

def Laws.overdue_exits(w, at, bg, e, lim):
  match e:
    case F.Start{h, t}:
      Unit{}
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{now}:
      Unit{}
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{+by, +log}:
      over_pick(log, F.Resumed{w, by, bg}, F.Overdue{w, at, bg}, Unit{}, Unit{})
    case F.Abandon{}:
      over_pick(F.is_zero(bg), F.Abandoned{w}, F.Overdue{w, at, bg}, Unit{}, Unit{})
    case F.Integrate{}:
      Unit{}

def Laws.running_stalls(w, h, hb, bg, now, lim, k):
  pick_true(F.late(now, hb, lim), F.Stalled{w, h, hb, bg}, F.Running{w, h, hb, bg}, k)

def Laws.stalled_interrupts(w, h, hb, bg, now, lim, k):
  pick_true(F.late(now, hb, Nat.add(lim, lim)), F.Interrupted{w, now, bg}, F.Stalled{w, h, hb, bg}, k)

# Law 3. Ends need reaped background processes
# ---------------------------------------------

def no_end(s: F.St) -> Type:
  Laws.T(Laws.is_end(s)) -> Empty

def pick_ne(ok: Bool, -x: F.St, -y: F.St, nx: no_end(x), ny: no_end(y), w: Laws.T(Laws.is_end(F.pick(ok, x, y)))) -> Empty:
  match ok:
    case True{}:
      nx(w)
    case False{}:
      ny(w)

def zero_pick(bg: Nat, -x: F.St, -y: F.St, ny: no_end(y), w: Laws.T(Laws.is_end(F.pick(F.is_zero(bg), x, y)))) -> {bg == 0n : Nat}:
  match bg:
    case 0n:
      {==}
    case 1n+k:
      Empty.absurd({1n+k == 0n : Nat}, ny(w))


def reap_running(+w: F.W, +h: F.Host, +hb: Nat, +bg: Nat, e: F.Ev, +lim: Nat, k: Laws.T(Laws.ends(F.Running{w, h, hb, bg}, F.step(F.Running{w, h, hb, bg}, e, lim)))) -> {bg == 0n : Nat}:
  match e:
    case F.Start{h, t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Beat{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Spawn{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Reap{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Tick{+now}:
      Empty.absurd({bg == 0n : Nat}, pick_ne(F.late(now, hb, lim), F.Stalled{w, h, hb, bg}, F.Running{w, h, hb, bg}, z => z, z => z, k))
    case F.Finish{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Interrupt{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Resume{by, log}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Abandon{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Integrate{}:
      Empty.absurd({bg == 0n : Nat}, k)

def reap_stalled(+w: F.W, +h: F.Host, +hb: Nat, +bg: Nat, e: F.Ev, +lim: Nat, k: Laws.T(Laws.ends(F.Stalled{w, h, hb, bg}, F.step(F.Stalled{w, h, hb, bg}, e, lim)))) -> {bg == 0n : Nat}:
  match e:
    case F.Start{h, t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Beat{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Spawn{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Reap{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Tick{+now}:
      Empty.absurd({bg == 0n : Nat}, pick_ne(F.late(now, hb, Nat.add(lim, lim)), F.Interrupted{w, now, bg}, F.Stalled{w, h, hb, bg}, z => z, z => z, k))
    case F.Finish{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Interrupt{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Resume{by, log}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Abandon{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Integrate{}:
      Empty.absurd({bg == 0n : Nat}, k)

def reap_interrupted(+w: F.W, +at: Nat, +bg: Nat, e: F.Ev, +lim: Nat, k: Laws.T(Laws.ends(F.Interrupted{w, at, bg}, F.step(F.Interrupted{w, at, bg}, e, lim)))) -> {bg == 0n : Nat}:
  match e:
    case F.Start{h, t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Beat{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Spawn{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Reap{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Tick{+now}:
      Empty.absurd({bg == 0n : Nat}, pick_ne(F.late(now, at, lim), F.Overdue{w, at, bg}, F.Interrupted{w, at, bg}, z => z, z => z, k))
    case F.Finish{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Interrupt{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Resume{+by, +log}:
      Empty.absurd({bg == 0n : Nat}, pick_ne(log, F.Resumed{w, by, bg}, F.Interrupted{w, at, bg}, z => z, z => z, k))
    case F.Abandon{}:
      zero_pick(bg, F.Abandoned{w}, F.Interrupted{w, at, bg}, z => z, k)
    case F.Integrate{}:
      Empty.absurd({bg == 0n : Nat}, k)

def reap_overdue(+w: F.W, +at: Nat, +bg: Nat, e: F.Ev, +lim: Nat, k: Laws.T(Laws.ends(F.Overdue{w, at, bg}, F.step(F.Overdue{w, at, bg}, e, lim)))) -> {bg == 0n : Nat}:
  match e:
    case F.Start{h, t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Beat{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Spawn{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Reap{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Tick{now}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Finish{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Interrupt{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Resume{+by, +log}:
      Empty.absurd({bg == 0n : Nat}, pick_ne(log, F.Resumed{w, by, bg}, F.Overdue{w, at, bg}, z => z, z => z, k))
    case F.Abandon{}:
      zero_pick(bg, F.Abandoned{w}, F.Overdue{w, at, bg}, z => z, k)
    case F.Integrate{}:
      Empty.absurd({bg == 0n : Nat}, k)

def reap_completed(+w: F.W, +bg: Nat, e: F.Ev, +lim: Nat, k: Laws.T(Laws.ends(F.Completed{w, bg}, F.step(F.Completed{w, bg}, e, lim)))) -> {bg == 0n : Nat}:
  match e:
    case F.Start{h, t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Beat{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Spawn{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Reap{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Tick{now}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Finish{}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Interrupt{t}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Resume{by, log}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Abandon{}:
      zero_pick(bg, F.Abandoned{w}, F.Completed{w, bg}, z => z, k)
    case F.Integrate{}:
      zero_pick(bg, F.Integrated{w}, F.Completed{w, bg}, z => z, k)

def Laws.end_needs_reaped(s, e, lim, k):
  match s:
    case F.Dispatched{+w}:
      {==}
    case F.Running{+w, +h, +hb, +bg}:
      reap_running(w, h, hb, bg, e, lim, k)
    case F.Stalled{+w, +h, +hb, +bg}:
      reap_stalled(w, h, hb, bg, e, lim, k)
    case F.Interrupted{+w, +at, +bg}:
      reap_interrupted(w, at, bg, e, lim, k)
    case F.Overdue{+w, +at, +bg}:
      reap_overdue(w, at, bg, e, lim, k)
    case F.Completed{+w, +bg}:
      reap_completed(w, bg, e, lim, k)
    case F.Resumed{+w, +by, +bg}:
      Empty.absurd({bg == 0n : Nat}, k)
    case F.Abandoned{+w}:
      {==}
    case F.Integrated{+w}:
      {==}

# Law 4. Placement: the reachable invariant
# -----------------------------------------
# Every running or stalled worker sits on a host its placement allows.

def inv_b(s: F.St) -> Bool:
  match s:
    case F.Dispatched{w}:
      True{}
    case F.Running{w, h, hb, bg}:
      F.placed(w, h)
    case F.Stalled{w, h, hb, bg}:
      F.placed(w, h)
    case F.Interrupted{w, at, bg}:
      True{}
    case F.Overdue{w, at, bg}:
      True{}
    case F.Completed{w, bg}:
      True{}
    case F.Resumed{w, by, bg}:
      True{}
    case F.Abandoned{w}:
      True{}
    case F.Integrated{w}:
      True{}

def Inv(s: F.St) -> Data:
  Laws.T(inv_b(s))

def pick_inv(ok: Bool, -x: F.St, -y: F.St, ix: Inv(x), iy: Inv(y)) -> Inv(F.pick(ok, x, y)):
  match ok:
    case True{}:
      ix
    case False{}:
      iy

def pick_dep(ok: Bool, -x: F.St, -y: F.St, ix: Laws.T(ok) -> Inv(x), iy: Inv(y)) -> Inv(F.pick(ok, x, y)):
  match ok:
    case True{}:
      ix(Unit{})
    case False{}:
      iy

def inv_dispatched(+w: F.W, e: F.Ev, +lim: Nat, +i: Inv(F.Dispatched{w})) -> Inv(F.step(F.Dispatched{w}, e, lim)):
  match e:
    case F.Start{+h, t}:
      pick_dep(F.placed(w, h), F.Running{w, h, t, 0n}, F.Dispatched{w}, z => z, Unit{})
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{now}:
      Unit{}
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{by, log}:
      Unit{}
    case F.Abandon{}:
      Unit{}
    case F.Integrate{}:
      Unit{}

def inv_running(+w: F.W, +h: F.Host, +hb: Nat, +bg: Nat, e: F.Ev, +lim: Nat, +i: Inv(F.Running{w, h, hb, bg})) -> Inv(F.step(F.Running{w, h, hb, bg}, e, lim)):
  match e:
    case F.Start{h, t}:
      i
    case F.Beat{t}:
      i
    case F.Spawn{}:
      i
    case F.Reap{}:
      i
    case F.Tick{+now}:
      pick_inv(F.late(now, hb, lim), F.Stalled{w, h, hb, bg}, F.Running{w, h, hb, bg}, i, i)
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{by, log}:
      i
    case F.Abandon{}:
      i
    case F.Integrate{}:
      i

def inv_stalled(+w: F.W, +h: F.Host, +hb: Nat, +bg: Nat, e: F.Ev, +lim: Nat, +i: Inv(F.Stalled{w, h, hb, bg})) -> Inv(F.step(F.Stalled{w, h, hb, bg}, e, lim)):
  match e:
    case F.Start{h, t}:
      i
    case F.Beat{t}:
      i
    case F.Spawn{}:
      i
    case F.Reap{}:
      i
    case F.Tick{+now}:
      pick_inv(F.late(now, hb, Nat.add(lim, lim)), F.Interrupted{w, now, bg}, F.Stalled{w, h, hb, bg}, Unit{}, i)
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{by, log}:
      i
    case F.Abandon{}:
      i
    case F.Integrate{}:
      i

def inv_interrupted(+w: F.W, +at: Nat, +bg: Nat, e: F.Ev, +lim: Nat, +i: Inv(F.Interrupted{w, at, bg})) -> Inv(F.step(F.Interrupted{w, at, bg}, e, lim)):
  match e:
    case F.Start{h, t}:
      Unit{}
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{+now}:
      pick_inv(F.late(now, at, lim), F.Overdue{w, at, bg}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{+by, +log}:
      pick_inv(log, F.Resumed{w, by, bg}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Abandon{}:
      pick_inv(F.is_zero(bg), F.Abandoned{w}, F.Interrupted{w, at, bg}, Unit{}, Unit{})
    case F.Integrate{}:
      Unit{}

def inv_overdue(+w: F.W, +at: Nat, +bg: Nat, e: F.Ev, +lim: Nat, +i: Inv(F.Overdue{w, at, bg})) -> Inv(F.step(F.Overdue{w, at, bg}, e, lim)):
  match e:
    case F.Start{h, t}:
      Unit{}
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{now}:
      Unit{}
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{+by, +log}:
      pick_inv(log, F.Resumed{w, by, bg}, F.Overdue{w, at, bg}, Unit{}, Unit{})
    case F.Abandon{}:
      pick_inv(F.is_zero(bg), F.Abandoned{w}, F.Overdue{w, at, bg}, Unit{}, Unit{})
    case F.Integrate{}:
      Unit{}

def inv_completed(+w: F.W, +bg: Nat, e: F.Ev, +lim: Nat, +i: Inv(F.Completed{w, bg})) -> Inv(F.step(F.Completed{w, bg}, e, lim)):
  match e:
    case F.Start{h, t}:
      Unit{}
    case F.Beat{t}:
      Unit{}
    case F.Spawn{}:
      Unit{}
    case F.Reap{}:
      Unit{}
    case F.Tick{now}:
      Unit{}
    case F.Finish{}:
      Unit{}
    case F.Interrupt{t}:
      Unit{}
    case F.Resume{by, log}:
      Unit{}
    case F.Abandon{}:
      pick_inv(F.is_zero(bg), F.Abandoned{w}, F.Completed{w, bg}, Unit{}, Unit{})
    case F.Integrate{}:
      pick_inv(F.is_zero(bg), F.Integrated{w}, F.Completed{w, bg}, Unit{}, Unit{})

def inv_step(s: F.St, e: F.Ev, +lim: Nat, i: Inv(s)) -> Inv(F.step(s, e, lim)):
  match s:
    case F.Dispatched{w}:
      inv_dispatched(w, e, lim, i)
    case F.Running{w, h, hb, bg}:
      inv_running(w, h, hb, bg, e, lim, i)
    case F.Stalled{w, h, hb, bg}:
      inv_stalled(w, h, hb, bg, e, lim, i)
    case F.Interrupted{w, at, bg}:
      inv_interrupted(w, at, bg, e, lim, i)
    case F.Overdue{w, at, bg}:
      inv_overdue(w, at, bg, e, lim, i)
    case F.Completed{w, bg}:
      inv_completed(w, bg, e, lim, i)
    case F.Resumed{w, by, bg}:
      i
    case F.Abandoned{w}:
      i
    case F.Integrated{w}:
      i

def reach(es: List<&2, F.Ev>, +lim: Nat, +s: F.St, i: Inv(s)) -> Inv(F.run(es, lim, s)):
  match es:
    case Nil{}:
      i
    case +e <> t:
      reach(t, lim, F.step(s, e, lim), inv_step(s, e, lim, i))

def inv_at(-x: F.St, -y: F.St, h: {x == y : F.St}, i: Inv(x)) -> Inv(y):
  %h : Inv(_)
  i

def reached(es: List<&2, F.Ev>, +lim: Nat, +w0: F.W, -y: F.St, h: {F.run(es, lim, F.Dispatched{w0}) == y : F.St}) -> Inv(y):
  +ees = es
  inv_at(F.run(ees, lim, F.Dispatched{w0}), y, h, reach(ees, lim, F.Dispatched{w0}, Unit{}))

def exc_ok(x: F.Exc, k: Laws.T(F.declared(x))) -> Laws.Excepted(x):
  match x:
    case F.NoExc{}:
      k
    case F.Gpu{}:
      Unit{}
    case F.Toolchain{}:
      Unit{}

def groot_ok(w: F.W, k: Laws.T(F.placed(w, F.Groot{}))) -> Laws.GrootOk(w):
  match w:
    case F.W{id, wt, load, exc}:
      match load:
        case F.Light{}:
          Unit{}
        case F.Heavy{}:
          exc_ok(exc, k)

def placed_ok(w: F.W, h: F.Host, k: Laws.T(F.placed(w, h))) -> Laws.Placed(w, h):
  match h:
    case F.Groot{}:
      groot_ok(w, k)
    case F.Mbp{}:
      Unit{}
    case F.Phone{}:
      Unit{}

def Laws.running_is_placed(es, lim, w0, w, h, hb, bg, k):
  placed_ok(w, h, reached(es, lim, w0, F.Running{w, h, hb, bg}, k))

def Laws.stalled_is_placed(es, lim, w0, w, h, hb, bg, k):
  placed_ok(w, h, reached(es, lim, w0, F.Stalled{w, h, hb, bg}, k))

# Laws 5 and 6. The phone
# -----------------------

def inst_lem(ok: Bool, +a: Nat, w: Laws.T(Laws.installed(F.epick(ok, F.Installed{a}, F.NoEff{})))) -> Laws.T(ok):
  match ok:
    case True{}:
      Unit{}
    case False{}:
      w

def typed_not_inst(ok: Bool, +a: Nat, +app: Nat, w: Laws.T(Laws.installed(F.epick(ok, F.Typed{a, app}, F.NoEff{})))) -> Empty:
  match ok:
    case True{}:
      w
    case False{}:
      w

def Laws.install_needs_lock(lk, fg, e, w):
  match e:
    case F.Lock{a}:
      w
    case F.Unlock{a}:
      w
    case F.Peek{app}:
      w
    case F.Install{+a}:
      Laws.write_needs_lease(lk, a, inst_lem(F.holds(lk, a), a, w))
    case F.Input{+a, +app}:
      typed_not_inst(F.fg_is(fg, app), a, app, w)

def Laws.install_lock_no_steal(o, fg, a):
  {==}

def typ_lem(ok: Bool, +a: Nat, +app: Nat, w: Laws.T(Laws.typed(F.epick(ok, F.Typed{a, app}, F.NoEff{})))) -> Laws.T(ok):
  match ok:
    case True{}:
      Unit{}
    case False{}:
      w

def inst_not_typed(ok: Bool, +a: Nat, w: Laws.T(Laws.typed(F.epick(ok, F.Installed{a}, F.NoEff{})))) -> Empty:
  match ok:
    case True{}:
      w
    case False{}:
      w

def fg_ok(f: F.Fg, +app: Nat, k: Laws.T(F.fg_is(f, app))) -> {f == F.Seen{app} : F.Fg}:
  match f:
    case F.Unknown{}:
      Empty.absurd({F.Unknown{} == F.Seen{app} : F.Fg}, k)
    case F.Seen{+x}:
      %eq_sound(x, app, k) : {F.Seen{x} == F.Seen{_} : F.Fg}
      {==}

def Laws.input_needs_foreground(lk, fg, e, w):
  match e:
    case F.Lock{a}:
      w
    case F.Unlock{a}:
      w
    case F.Peek{app}:
      w
    case F.Install{+a}:
      inst_not_typed(F.holds(lk, a), a, w)
    case F.Input{+a, +app}:
      fg_ok(fg, app, typ_lem(F.fg_is(fg, app), a, app, w))

def Laws.input_needs_fresh_look(lk, fg, a, x, b, y):
  {==}
